<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dashboard - ACC Portal</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>
    <h1>Dashboard (Index)</h1>
    <p>Welcome, <span id="user-display">Loading...</span>!</p>
    <p>Your Role: <strong id="role-display" style="text-transform: uppercase;">Loading...</strong></p>

    <hr>

    <!-- Role-Protected Sections -->
    <div id="user-section" style="display:none; background: #e2e8f0; padding: 10px; margin-bottom: 10px;">
        <h3>Standard User Panel</h3>
        <p>Visible to all logged-in users.</p>
    </div>

    <div id="moderator-section" style="display:none; background: #fef08a; padding: 10px; margin-bottom: 10px;">
        <h3>Moderator Panel</h3>
        <p>Visible only to Moderators and Admins.</p>
    </div>

    <div id="admin-section" style="display:none; background: #fecaca; padding: 10px; margin-bottom: 10px;">
        <h3>Admin Panel</h3>
        <p>Visible only to Admins.</p>
    </div>

    <hr>
    <p>
        <a href="account.html">Go to Account Settings</a> | 
        <button id="logout-btn">Log Out</button>
    </p>

    <script>
        const SUPABASE_URL = 'https://klduwrrqoyuyridfiutd.supabase.co';
        const SUPABASE_ANON_KEY = 'YOUR_SUPABASE_ANON_KEY';
        const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        async function initDashboard() {
            // 1. Check Auth Session
            const { data: { session }, error } = await supabase.auth.getSession();
            if (error || !session) {
                window.location.href = 'index.html'; // Kick out if not logged in
                return;
            }

            const user = session.user;

            // 2. Fetch User Role & Username from 'profiles' table
            const { data: profile, profileError } = await supabase
                .from('profiles')
                .select('username, role')
                .eq('id', user.id)
                .single();

            if (profileError || !profile) {
                document.getElementById('user-display').innerText = user.email;
                document.getElementById('role-display').innerText = 'user';
                document.getElementById('user-section').style.display = 'block';
                return;
            }

            // 3. Populate UI details
            document.getElementById('user-display').innerText = profile.username || user.email;
            const userRole = profile.role || 'user';
            document.getElementById('role-display').innerText = userRole;

            // 4. Apply Role-Based Access Control (RBAC) visibility
            if (['user', 'moderator', 'admin'].includes(userRole)) {
                document.getElementById('user-section').style.display = 'block';
            }
            if (['moderator', 'admin'].includes(userRole)) {
                document.getElementById('moderator-section').style.display = 'block';
            }
            if (userRole === 'admin') {
                document.getElementById('admin-section').style.display = 'block';
            }
        }

        initDashboard();

        // Logout functionality
        document.getElementById('logout-btn').addEventListener('click', async () => {
            await supabase.auth.signOut();
            window.location.href = 'index.html';
        });
    </script>
</body>
</html>